# パスワード保護機能の設定
# true: パスワード保護を有効にする
# false: パスワード保護を無効にする
NEXT_PUBLIC_PASSWORD_PROTECTED=true

# サイトアクセス用パスワード
# 本番環境では強力なパスワードを設定してください
# 注意: クライアントサイドで使用されるため、NEXT_PUBLIC_プレフィックスが必要
NEXT_PUBLIC_SITE_PASSWORD=oyashiro

# Formspree設定（追加）
NEXT_PUBLIC_FORMSPREE_FORM_ID=xkgvokyy

# 管理者メールアドレス（追加）
NEXT_PUBLIC_ADMIN_EMAIL=oyashiro@shinmei0846.jp